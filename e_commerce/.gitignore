# --- Backend Caches & Environments ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
backend/env/
backend/venv/
backend/.venv/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# --- Backend Local Secrets & Configs ---
backend/.env
backend/.env.*
!backend/.env.example
backend/secrets.json
backend/*.sql

# --- Backend Uploads & Media ---
backend/static/uploads/*
!backend/static/uploads/.gitkeep

# --- Backend Scratch & Maintenance ---
backend/map_images.py
backend/seed_products.py
backend/migrate_*.py
backend/scratch/
backend/crash.txt

# --- Frontend Node & Caches ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.*
frontend/.eslintcache
frontend/npm-debug.log*

# --- Editor / IDE Settings ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS Metadata ---
.DS_Store
Thumbs.db

# --- Docker Caches ---
.docker/
**/docker-compose.override.yml